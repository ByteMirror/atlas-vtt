          "display": "HP",
          "properties": [
            "hp"
          ],
          "conditioned": true,
          "dice": true,
          "diceProperty": "hit_dice",
          "diceCallback": "if (\"hit_dice\" in monster) {\n  return [{ text: monster[\"hit_dice\"] }];\n} else {\n  return property;\n}\n",
          "callback": "let str = [monster.hp];\nif (monster.hit_dice?.length) { str.push(`(${monster.hit_dice})`); }\nreturn str.join(\" \");\n"

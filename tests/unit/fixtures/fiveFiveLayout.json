              "conditioned": true,
              "callback": "const ac = [monster.ac];\nif (\"ac_class\" in monster && `${monster.ac_class}`.length) {\n  ac.push(`(${monster.ac_class})`);\n}\nreturn ac.join(\" \");\n"
            },

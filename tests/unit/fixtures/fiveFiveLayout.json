        {
          "type": "property",
          "id": "det55e_resist",
          "display": "Resistances",
          "properties": [
            "resistances",
            "damage_resistances"
          ],
          "conditioned": true,
          "callback": "const parts = [];\nconst push = (v) => {\n  if (v === undefined || v === null) return;\n  const s = Array.isArray(v) ? v.filter(Boolean).join(\", \") : String(v);\n  if (s.trim().length) parts.push(s.trim());\n};\npush(monster[\"resistances\"]);\npush(monster[\"damage_resistances\"]);\nreturn parts.join(\"; \");\n"
        },
        {
          "type": "property",
          "id": "det55e_immune",
          "display": "Immunities",
          "properties": [
            "immunities",
            "damage_immunities",
            "condition_immunities"
          ],
          "conditioned": true,
          "callback": "const parts = [];\nconst push = (v) => {\n  if (v === undefined || v === null) return;\n  const s = Array.isArray(v) ? v.filter(Boolean).join(\", \") : String(v);\n  if (s.trim().length) parts.push(s.trim());\n};\npush(monster[\"immunities\"]);\npush(monster[\"damage_immunities\"]);\npush(monster[\"condition_immunities\"]);\nreturn parts.join(\"; \");\n"
        },
        {
          "type": "property",
          "id": "det55e_vuln",
          "display": "Vulnerabilities",
          "properties": [
            "vulnerabilities",
            "damage_vulnerabilities"
          ],
          "conditioned": true,
          "callback": "const parts = [];\nconst push = (v) => {\n  if (v === undefined || v === null) return;\n  const s = Array.isArray(v) ? v.filter(Boolean).join(\", \") : String(v);\n  if (s.trim().length) parts.push(s.trim());\n};\npush(monster[\"vulnerabilities\"]);\npush(monster[\"damage_vulnerabilities\"]);\nreturn parts.join(\"; \");\n"
        },
        {
          "type": "property",
          "id": "det55e_gear",
          "display": "Gear",
          "properties": [
            "gear"
          ],
          "conditioned": true
        },
        {
          "type": "property",
          "id": "det55e_senses",
          "display": "Senses",
          "properties": [
            "senses",
            "passive"
          ],
          "conditioned": true,
          "callback": "const s = monster.senses;\nlet out = Array.isArray(s) ? s.filter(Boolean).join(\", \") : String(s ?? \"\").trim();\nconst p = monster.passive ?? monster.passive_perception;\nif (p !== undefined && p !== null && `${p}`.trim().length &&\n    !/passive\\s+perception/i.test(out)) {\n  out = out.length ? `${out}; Passive Perception ${p}` : `Passive Perception ${p}`;\n}\nreturn out;\n"
        },
        {
          "type": "property",
          "id": "det55e_langs",
          "display": "Languages",
          "properties": [
            "languages"
          ],
          "fallback": "None"
        },
        {
          "type": "property",
          "id": "det55e_cr",
          "display": "CR",
          "properties": [
            "cr"
          ],
          "conditioned": true,
          "callback": "const CR = {\n  \"0\": { v: 0, xp: 10 }, \"1/8\": { v: 0.125, xp: 25 }, \"0.125\": { v: 0.125, xp: 25 },\n  \"1/4\": { v: 0.25, xp: 50 }, \"0.25\": { v: 0.25, xp: 50 },\n  \"1/2\": { v: 0.5, xp: 100 }, \"0.5\": { v: 0.5, xp: 100 },\n  \"1\": { v: 1, xp: 200 }, \"2\": { v: 2, xp: 450 }, \"3\": { v: 3, xp: 700 },\n  \"4\": { v: 4, xp: 1100 }, \"5\": { v: 5, xp: 1800 }, \"6\": { v: 6, xp: 2300 },\n  \"7\": { v: 7, xp: 2900 }, \"8\": { v: 8, xp: 3900 }, \"9\": { v: 9, xp: 5000 },\n  \"10\": { v: 10, xp: 5900 }, \"11\": { v: 11, xp: 7200 }, \"12\": { v: 12, xp: 8400 },\n  \"13\": { v: 13, xp: 10000 }, \"14\": { v: 14, xp: 11500 }, \"15\": { v: 15, xp: 13000 },\n  \"16\": { v: 16, xp: 15000 }, \"17\": { v: 17, xp: 18000 }, \"18\": { v: 18, xp: 20000 },\n  \"19\": { v: 19, xp: 22000 }, \"20\": { v: 20, xp: 25000 }, \"21\": { v: 21, xp: 33000 },\n  \"22\": { v: 22, xp: 41000 }, \"23\": { v: 23, xp: 50000 }, \"24\": { v: 24, xp: 62000 },\n  \"25\": { v: 25, xp: 75000 }, \"26\": { v: 26, xp: 90000 }, \"27\": { v: 27, xp: 105000 },\n  \"28\": { v: 28, xp: 120000 }, \"29\": { v: 29, xp: 135000 }, \"30\": { v: 30, xp: 155000 }\n};\n\nconst raw = monster.cr;\nconst key = String(\n  raw && typeof raw === \"object\" ? (raw.cr ?? \"\") : (raw ?? \"\")\n).trim();\nif (!key.length) return \"\";\nconst entry = CR[key];\nif (!entry) return key;\nconst num = (x) => Number(x).toLocaleString(\"en-US\");\nconst pb = monster.pb ?? monster.proficiency_bonus ??\n  Math.max(2, Math.floor(2 + (entry.v - 1) / 4));\nconst xp = monster.xp ?? (raw && typeof raw === \"object\" ? raw.xp : undefined) ?? entry.xp;\nconst lair = monster.xp_lair ?? monster.xpLair ??\n  (raw && typeof raw === \"object\" ? raw.xpLair : undefined);\nlet out = `${key} (XP ${num(xp)}`;\nif (lair) out += `, or ${num(lair)} in lair`;\nout += `; PB +${pb})`;\nreturn out;\n"
        }
      ]
